#!/bin/bash
# Controle do daemon mm-notify.
#   mm-ctl start | stop | restart | status | logs | instalar | desinstalar
set -uo pipefail

# Resolve symlinks antes de calcular a raiz: chamado via ~/.local/bin/mm-ctl,
# um dirname simples apontaria para ~/.local e o script não acharia o projeto.
ORIGEM="${BASH_SOURCE[0]}"
while [ -L "$ORIGEM" ]; do
  ALVO="$(readlink "$ORIGEM")"
  case "$ALVO" in
    /*) ORIGEM="$ALVO" ;;
    *)  ORIGEM="$(dirname "$ORIGEM")/$ALVO" ;;
  esac
done
RAIZ="$(cd "$(dirname "$ORIGEM")/.." && pwd)"

# Como o usuário chama este script: nome curto se estiver no PATH.
if command -v mm-ctl >/dev/null 2>&1; then EU="mm-ctl"; else EU="$ORIGEM"; fi
ROTULO="com.cauatoledo.mmnotify"
PLIST_ORIGEM="$RAIZ/$ROTULO.plist"
PLIST_DESTINO="$HOME/Library/LaunchAgents/$ROTULO.plist"
# Atualização automática: serviço à parte, que roda o mm-atualizar periodicamente.
ROTULO_ATU="$ROTULO.atualizar"
PLIST_ATU_ORIGEM="$RAIZ/$ROTULO_ATU.plist"
PLIST_ATU_DESTINO="$HOME/Library/LaunchAgents/$ROTULO_ATU.plist"
LOG="$RAIZ/logs/mm-notify.log"
ERR="$RAIZ/logs/mm-notify.err"
UID_ATUAL="$(id -u)"

# O Linux usa systemd de usuario; o macOS, launchd. As funcoes abaixo
# escondem essa diferenca do resto do script.
SISTEMA="$(uname -s)"

carregado() {
  if [ "$SISTEMA" = "Darwin" ]; then
    launchctl print "gui/$UID_ATUAL/$ROTULO" >/dev/null 2>&1
  else
    systemctl --user is-active --quiet mm-notify.service
  fi
}

case "${1:-status}" in
  instalar)
    mkdir -p "$HOME/Library/LaunchAgents"
    cp "$PLIST_ORIGEM" "$PLIST_DESTINO"
    # Descarrega o serviço anterior e ESPERA sumir de verdade. Sem esta espera
    # o bootstrap seguinte falha com "Input/output error", porque o launchd
    # ainda considera o rótulo em uso.
    launchctl bootout "gui/$UID_ATUAL/$ROTULO" 2>/dev/null
    for _ in $(seq 1 20); do
      carregado || break
      sleep 0.25
    done

    if launchctl bootstrap "gui/$UID_ATUAL" "$PLIST_DESTINO" 2>/tmp/mmctl-erro.$$; then
      echo "✓ Instalado e iniciado. Vai subir sozinho a cada login."
    else
      echo "✗ Falha ao instalar o LaunchAgent:"
      sed 's/^/    /' /tmp/mmctl-erro.$$
      echo "    Se disser que já está carregado, rode: $EU restart"
      rm -f /tmp/mmctl-erro.$$
      exit 1
    fi
    rm -f /tmp/mmctl-erro.$$

    # Atualização automática. Se já está carregada, só troca o arquivo: é
    # justamente ela que chama este comando durante uma atualização, e um
    # bootout aqui mataria o atualizador no meio do trabalho. O arquivo novo
    # vale a partir do próximo login.
    if [ -f "$PLIST_ATU_ORIGEM" ]; then
      cp "$PLIST_ATU_ORIGEM" "$PLIST_ATU_DESTINO"
      if launchctl print "gui/$UID_ATUAL/$ROTULO_ATU" >/dev/null 2>&1; then
        echo "✓ Atualização automática já ativa."
      elif launchctl bootstrap "gui/$UID_ATUAL" "$PLIST_ATU_DESTINO" 2>/dev/null; then
        echo "✓ Atualização automática ativada (no login e a cada 6 h)."
      else
        echo "⚠ Não consegui ativar a atualização automática; use $EU atualizar."
      fi
    fi
    ;;

  desinstalar)
    launchctl bootout "gui/$UID_ATUAL/$ROTULO" 2>/dev/null
    launchctl bootout "gui/$UID_ATUAL/$ROTULO_ATU" 2>/dev/null
    rm -f "$PLIST_DESTINO" "$PLIST_ATU_DESTINO"
    echo "✓ Removido. Não sobe mais no login."
    ;;

  start)
    if [ "$SISTEMA" != "Darwin" ]; then
      systemctl --user start mm-notify.service && echo "✓ Iniciado."; exit $?
    fi
    if [ ! -f "$PLIST_DESTINO" ]; then
      echo "LaunchAgent não instalado. Rode primeiro:"; echo "  $EU instalar"; exit 1
    fi
    launchctl kickstart "gui/$UID_ATUAL/$ROTULO" && echo "✓ Iniciado."
    ;;

  stop)
    if [ "$SISTEMA" != "Darwin" ]; then
      systemctl --user stop mm-notify.service && echo "✓ Parado."; exit $?
    fi
    launchctl kill SIGTERM "gui/$UID_ATUAL/$ROTULO" 2>/dev/null \
      && echo "✓ Parado (o launchd vai relançar; use 'desinstalar' para desligar de vez)." \
      || echo "Não estava rodando."
    ;;

  restart)
    if [ "$SISTEMA" != "Darwin" ]; then
      systemctl --user restart mm-notify.service && echo "✓ Reiniciado."; exit $?
    fi
    launchctl kickstart -k "gui/$UID_ATUAL/$ROTULO" && echo "✓ Reiniciado."
    ;;

  status)
    echo "mm-notify"
    echo "  raiz:        $RAIZ"
    if [ "$SISTEMA" = "Darwin" ]; then
      if [ -f "$PLIST_DESTINO" ]; then echo "  LaunchAgent: instalado"; else echo "  LaunchAgent: NÃO instalado (rode: $EU instalar)"; fi
      if launchctl print "gui/$UID_ATUAL/$ROTULO_ATU" >/dev/null 2>&1; then
        echo "  atualização: automática (no login e a cada 6 h)"
      else
        echo "  atualização: manual (rode: $EU instalar para ativar a automática)"
      fi
    else
      systemctl --user is-enabled --quiet mm-notify.service 2>/dev/null \
        && echo "  serviço systemd: habilitado" || echo "  serviço systemd: NÃO habilitado (rode: bash instalar-linux.sh)"
    fi
    if carregado; then
      pid="$(launchctl print "gui/$UID_ATUAL/$ROTULO" 2>/dev/null | awk '/^\tpid = /{print $3}')"
      echo "  daemon:      rodando${pid:+ (pid $pid)}"
    else
      echo "  daemon:      parado"
    fi
    if [ "$SISTEMA" = "Darwin" ]; then MARCA="MMPopup.app/Contents/MacOS/MMPopup"; else MARCA="popup-linux.py"; fi
    if pgrep -f "$MARCA" >/dev/null 2>&1; then
      echo "  popup:       rodando"
    else
      echo "  popup:       parado"
    fi
    if [ "$SISTEMA" = "Darwin" ]; then
      if [ -f "$RAIZ/mmpopup/MMPopup.app/Contents/MacOS/MMPopup" ]; then
        echo "  MMPopup.app: compilado"
      else
        echo "  MMPopup.app: NÃO compilado (rode: bash mmpopup/build.sh)"
      fi
    else
      python3 -c "import tkinter" 2>/dev/null \
        && echo "  popup Python: pronto" || echo "  popup Python: tkinter AUSENTE (apt install python3-tk)"
    fi
    echo ""
    echo "  últimas linhas do log:"
    tail -n 8 "$LOG" 2>/dev/null | sed 's/^/    /' || echo "    (sem log ainda)"
    ;;

  logs)
    echo "Acompanhando $LOG  (Ctrl-C para sair)"
    touch "$LOG" "$ERR"
    tail -n 40 -f "$LOG" "$ERR"
    ;;

  atualizar)
    # Auto-update a partir de GitHub Releases. Delega para bin/mm-atualizar;
    # se ele não existir (instalação antiga), avisa em vez de falhar.
    if [ ! -x "$RAIZ/bin/mm-atualizar" ]; then
      echo "✗ bin/mm-atualizar não encontrado nesta instalação."
      echo "  Atualize manualmente: cd $RAIZ && git pull"
      exit 1
    fi
    exec node "$RAIZ/bin/mm-atualizar" "$@"
    ;;

  checar-atualizacao)
    # Igual a `atualizar`, mas só consulta a API — não baixa nem modifica nada.
    # Usado pelo menu-bar do wrapper para avisar sem instalar.
    if [ ! -x "$RAIZ/bin/mm-atualizar" ]; then
      echo "sem atualizador instalado"; exit 0
    fi
    # Implementação mínima: chama o atualizador com --checar (que ele entende).
    exec node "$RAIZ/bin/mm-atualizar" --checar
    ;;

  reinstalar)
    # Repatcha o plist para apontar para o caminho atual do projeto.
    # Útil quando o usuário move ~/mm-notify para outro lugar.
    PLIST="$RAIZ/$ROTULO.plist"
    python3 - "$PLIST" "$RAIZ" <<'PY'
import sys, re, pathlib
plist, raiz = sys.argv[1], sys.argv[2]
p = pathlib.Path(plist); s = p.read_text()
s = re.sub(r"<string>[^<]*/mm-notify(/[^<]*)?</string>",
           lambda m: f"<string>{raiz}{m.group(1) or ''}</string>", s)
p.write_text(s)
PY
    "$EU" restart
    echo "✓ plist reapontado para $RAIZ"
    ;;

  *)
    echo "uso: $EU {instalar|desinstalar|start|stop|restart|status|logs|atualizar|checar-atualizacao|reinstalar}"
    exit 1
    ;;
esac

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cauatoledo.mmnotify</string>

    <!-- O launchd não herda o PATH do shell. Setamos um PATH completo no
         EnvironmentVariables abaixo — cobre Homebrew (Apple Silicon e Intel),
         /usr/local e o resto do sistema. O node é resolvido por nome, não por
         caminho absoluto, então mover o Node entre gerenciadores (nvm, volta,
         Homebrew) não exige repatch. -->
    <key>ProgramArguments</key>
    <array>
        <string>node</string>
        <string>/Users/cauatoledo/mm-notify/src/index.js</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/cauatoledo/mm-notify</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- Se cair, o macOS relança. -->
    <key>KeepAlive</key>
    <true/>

    <!-- Espera crescente entre relançamentos, para não entrar em loop apertado
         se o servidor estiver fora do ar. -->
    <key>ThrottleInterval</key>
    <integer>15</integer>

    <key>StandardOutPath</key>
    <string>/Users/cauatoledo/mm-notify/logs/mm-notify.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/cauatoledo/mm-notify/logs/mm-notify.err</string>

    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
